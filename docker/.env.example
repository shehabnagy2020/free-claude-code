# Claude Code Proxy - Docker Environment Configuration
# Copy this file to .env and configure your provider

# ==================== Provider Selection ====================
# Format: provider_type/model/name
# Valid providers: nvidia_nim, google_gemini, open_router, deepseek, lmstudio, llamacpp, ollama
MODEL=nvidia_nim/z-ai/glm4.7

# Per-model overrides (optional)
# MODEL_OPUS=
# MODEL_SONNET=
# MODEL_HAIKU=

# ==================== NVIDIA NIM ====================
# Get API key: https://build.nvidia.com/settings/api-keys
NVIDIA_NIM_API_KEY=

# Optional proxy (http or socks5)
# NVIDIA_NIM_PROXY=

# ==================== OpenRouter ====================
# Get API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional proxy
# OPENROUTER_PROXY=

# ==================== DeepSeek ====================
# Get API key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ==================== Google Gemini ====================
# Get API key: https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=

# Optional proxy
# GOOGLE_GEMINI_PROXY=

# ==================== LM Studio ====================
# Option 1: Run LM Studio Desktop on host (recommended)
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
# Option 2: Run in Docker (see docker-compose.yml)
# LM_STUDIO_BASE_URL=http://lm-studio:1234/v1
# LM_STUDIO_MODEL=  # Model to auto-load in containerized LM Studio
# LMSTUDIO_PROXY=

# ==================== Llama.cpp ====================
# Option 1: Run llama.cpp server on host
# LLAMACPP_BASE_URL=http://host.docker.internal:8080/v1
# Option 2: Run in Docker (default)
LLAMACPP_BASE_URL=http://llama-cpp:8080/v1
# LLAMA_CPP_MODEL=  # Path to .gguf model in container (e.g., /models/llama-3.2-1b.gguf)
# LLAMACPP_PROXY=

# ==================== Ollama ====================
# Runs in Docker by default
OLLAMA_BASE_URL=http://ollama:11434
# To pull models: docker exec ollama ollama pull llama3.2

# ==================== Authentication ====================
# Optional: Set API key to protect proxy endpoints
ANTHROPIC_AUTH_TOKEN=freecc

# Web Chat UI password
UI_PASSWORD=Shehab

# ==================== Messaging Platform ====================
# Options: "telegram", "discord", "none"
MESSAGING_PLATFORM=none
MESSAGING_RATE_LIMIT=1
MESSAGING_RATE_WINDOW=1.0

# Telegram (if MESSAGING_PLATFORM=telegram)
# TELEGRAM_BOT_TOKEN=
# ALLOWED_TELEGRAM_USER_ID=

# Discord (if MESSAGING_PLATFORM=discord)
# DISCORD_BOT_TOKEN=
# ALLOWED_DISCORD_CHANNELS=

# ==================== Voice Transcription ====================
VOICE_NOTE_ENABLED=false
# Options: "cpu", "cuda", "nvidia_nim"
WHISPER_DEVICE=cpu
WHISPER_MODEL=base
# HF_TOKEN=

# ==================== Web Tools (Tavily) ====================
# Get API key: https://tavily.com
ENABLE_WEB_SERVER_TOOLS=true
# TAVILY_API_KEY=

# ==================== Context Mode ====================
# Requires npm/node - enables sandboxed tool routing
ENABLE_CONTEXT_MODE=false

# ==================== Rate Limiting ====================
PROVIDER_RATE_LIMIT=20
PROVIDER_RATE_WINDOW=60
PROVIDER_MAX_CONCURRENCY=2

# ==================== HTTP Timeouts (seconds) ====================
HTTP_READ_TIMEOUT=300.0
HTTP_WRITE_TIMEOUT=60.0
HTTP_CONNECT_TIMEOUT=10.0

# ==================== Optimizations ====================
ENABLE_MODEL_THINKING=true
FAST_PREFIX_DETECTION=true
ENABLE_NETWORK_PROBE_MOCK=true
ENABLE_TITLE_GENERATION_SKIP=true
ENABLE_SUGGESTION_MODE_SKIP=true
ENABLE_FILEPATH_EXTRACTION_MOCK=true

# ==================== Debug Logging ====================
LOG_RAW_API_PAYLOADS=false
LOG_RAW_SSE_EVENTS=false
LOG_API_ERROR_TRACEBACKS=false
LOG_RAW_MESSAGING_CONTENT=false
LOG_RAW_CLI_DIAGNOSTICS=false
LOG_MESSAGING_ERROR_DETAILS=false
